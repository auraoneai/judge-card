{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Judge Card v1",
  "type": "object",
  "required": [
    "model_id",
    "prompt_hash",
    "calibration_summary",
    "known_biases",
    "recommended_use",
    "generated_at"
  ],
  "properties": {
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "prompt_hash": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "calibration_summary": {
      "type": "object"
    },
    "known_biases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "probe",
          "value"
        ],
        "properties": {
          "probe": {
            "type": "string",
            "minLength": 1
          },
          "value": {}
        }
      }
    },
    "recommended_use": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "synthetic": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
